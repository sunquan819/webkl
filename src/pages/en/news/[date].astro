---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { url } from '../../../utils/url';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const newsEntries = await getCollection('news-en');
  return newsEntries.map(entry => ({
    params: { date: entry.data.date },
    props: { entry },
  }));
}

const { entry } = Astro.props;

// Parse news content
const newsItems = entry.body.split('\n').filter(line => line.trim() && line.includes('**'));

// Calculate stats
const totalItems = newsItems.length;
const categories = ['Politics', 'Economy', 'Tech', 'Sports', 'Culture', 'Society'];

// Get prev/next dates
const allDates = (await getCollection('news-en')).map(e => e.data.date).sort().reverse();
const currentIndex = allDates.indexOf(entry.data.date);
const prevDate = currentIndex > 0 ? allDates[currentIndex - 1] : null;
const nextDate = currentIndex < allDates.length - 1 ? allDates[currentIndex + 1] : null;
---

<BaseLayout
  title={`Global Events on ${entry.data.date}`}
  description={`Major global events summary for ${entry.data.date} - ${totalItems} news items`}
>
  <Breadcrumb items={[
    { label: 'Home', href: '/webkl/en/' },
    { label: 'Daily News', href: '/webkl/en/news/' },
    { label: entry.data.date, href: Astro.url.pathname },
  ]} />

  <div class="max-w-5xl mx-auto">
    <!-- Header -->
    <header class="mb-10">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h1 class="text-4xl font-bold text-gray-900 mb-2">
            Global Events on {entry.data.date}
          </h1>
          <p class="text-gray-500">
            <span class="text-primary font-semibold">{totalItems}</span> major news items
          </p>
        </div>
        <div class="flex gap-2">
          {prevDate && (
            <a href={`/webkl/en/news/${prevDate}/`} class="px-4 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 transition-colors text-sm">
              ← {prevDate}
            </a>
          )}
          {nextDate && (
            <a href={`/webkl/en/news/${nextDate}/`} class="px-4 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 transition-colors text-sm">
              {nextDate} →
            </a>
          )}
        </div>
      </div>

      <!-- Stats -->
      <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl p-6 mb-8">
        <div class="grid grid-cols-3 md:grid-cols-6 gap-4">
          {categories.map(cat => (
            <div class="text-center">
              <div class="text-2xl mb-1">
                {cat === 'Politics' && '🏛️'}
                {cat === 'Economy' && '💰'}
                {cat === 'Tech' && '🔬'}
                {cat === 'Sports' && '⚽'}
                {cat === 'Culture' && '🎭'}
                {cat === 'Society' && '👥'}
              </div>
              <div class="text-xs text-gray-600">{cat}</div>
            </div>
          ))}
        </div>
      </div>
    </header>

    <!-- News List -->
    <div class="space-y-6">
      {newsItems.map((item, index) => {
        const match = item.match(/\*\*(.+?)\*\*/);
        const title = match ? match[1] : '';
        const sourceMatch = title.match(/- (.+)$/);
        const source = sourceMatch ? sourceMatch[1] : 'Various';
        const cleanTitle = title.replace(/- .+$/, '').trim();
        
        return (
          <article class="bg-white rounded-lg border border-gray-100 hover:shadow-md transition-all duration-300 overflow-hidden">
            <div class="p-6">
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center text-primary font-bold">
                  {index + 1}
                </div>
                <div class="flex-1">
                  <h3 class="text-lg font-semibold text-gray-900 mb-2 hover:text-primary transition-colors">
                    {cleanTitle}
                  </h3>
                  <div class="flex items-center gap-3 text-sm text-gray-500">
                    <span class="flex items-center gap-1">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 01-2-2V7a2 2 0 012-2m2 13a2 2 0 01-2-2V9a2 2 0 012-2"/>
                      </svg>
                      {source}
                    </span>
                    <span class="px-2 py-1 bg-gray-100 rounded text-xs">
                      {entry.data.date}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Footer -->
    <footer class="mt-12 pt-8 border-t border-gray-200">
      <div class="flex items-center justify-between">
        <div class="text-gray-500 text-sm">
          Source: Google News RSS
        </div>
        <div class="flex gap-3">
          <a href="/webkl/en/news/" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-secondary transition-colors font-medium">
            View More Dates
          </a>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>